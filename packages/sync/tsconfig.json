{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "ignoreDeprecations": "5.0",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
