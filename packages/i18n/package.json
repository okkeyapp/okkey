{
  "name": "@okkey/i18n",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "dependencies": {
    "intl-messageformat": "^10.7.0"
  },
  "scripts": {
    "build": "node scripts/gen-locale-bundles.mjs && tsc -p tsconfig.json && node scripts/copy-locale-json.mjs",
    "check:coverage": "node scripts/check-locale-coverage.mjs",
    "check:style": "node scripts/check-locale-style.mjs",
    "report:long-strings": "node scripts/report-long-strings.mjs",
    "test": "node --test dist/*.test.js scripts/*.test.mjs"
  }
}
