{
  "name": "@okkey/vault",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./vault-bundle": {
      "types": "./dist/vault-bundle.d.ts",
      "import": "./dist/vault-bundle.js",
      "default": "./src/vault-bundle.ts"
    },
    "./server-key-share-memory": {
      "types": "./dist/server-key-share-memory.d.ts",
      "import": "./dist/server-key-share-memory.js",
      "default": "./src/server-key-share-memory.ts"
    },
    "./unlock-with-master-password": {
      "types": "./dist/unlock-with-master-password.d.ts",
      "import": "./dist/unlock-with-master-password.js",
      "default": "./src/unlock-with-master-password.ts"
    },
    "./device-share-wire": {
      "types": "./dist/device-share-wire.d.ts",
      "import": "./dist/device-share-wire.js",
      "default": "./src/device-share-wire.ts"
    },
    "./split-key-share-wrap-store": {
      "types": "./dist/split-key-share-wrap-store.d.ts",
      "import": "./dist/split-key-share-wrap-store.js",
      "default": "./src/split-key-share-wrap-store.ts"
    }
    }
  },
  "files": ["dist", "src"],
  "dependencies": {
    "@okkey/api": "0.0.1",
    "@okkey/crypto": "0.0.1",
    "@okkey/sync": "0.0.1",
    "@okkey/types": "0.0.1",
    "@okkey/ui": "0.0.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test src/*.test.ts src/**/*.test.ts"
  }
}
