{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "outDir": "dist",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@okkey/types": ["../types/src"],
      "@okkey/api": ["../api/src"]
    },
    "skipLibCheck": true
  },
  "include": ["src", "../types/src", "../api/src"]
}
