{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@okkey/ui": ["../../packages/ui/src/index.ts"],
      "@okkey/vault-ui": ["../../packages/vault-ui/src/index.ts"],
      "@okkey/api": ["../../packages/api/src/index.ts"],
      "@okkey/auth": ["../../packages/auth/src/index.ts"],
      "@okkey/types": ["../../packages/types/src/index.ts"],
      "@okkey/id": ["../../packages/id/src/index.ts"],
      "@okkey/crypto": ["../../packages/crypto/src/index.ts"],
      "@okkey/vault": ["../../packages/vault/src/index.ts"],
      "@okkey/sync": ["../../packages/sync/src/index.ts"],
      "@okkey/sync/item-sync": ["../../packages/sync/src/item-sync.ts"],
      "@okkey/i18n": ["../../packages/i18n/src/index.ts"]
    }
  },
  "include": ["src", "wxt.config.ts"]
}
