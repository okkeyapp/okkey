{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@okkey/ui": ["../../packages/ui/src/index.ts"],
      "@okkey/api": ["../../packages/api/src/index.ts"],
      "@okkey/auth": ["../../packages/auth/src/index.ts"],
      "@okkey/types": ["../../packages/types/src/index.ts"],
      "@okkey/id": ["../../packages/id/src/index.ts"]
    }
  },
  "include": ["src", "wxt.config.ts"]
}
