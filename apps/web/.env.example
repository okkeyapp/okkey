# Copy to `.env` for local overrides (do not commit secrets).
#
# Vite dev server: http://localhost:5173 (see vite.config.ts)

VITE_APP_ENV=development
# Must be the API origin (port 4000), not the Vite dev server (5173). Avoid the literal string "undefined".
VITE_API_BASE_URL=http://localhost:4000
VITE_S3_BASE_URL=http://localhost:9000
# false = FREE-only UI (default). true = load okkey-enterprise web modules.
VITE_ENTERPRISE_MODULES=false
# self_hosted (default) | saas — multi-workspace create UI requires enterprise modules + saas.
# VITE_DEPLOYMENT_MODE=self_hosted
#
# Optional: override domain capabilities catalog URLs (defaults: okkey/domain-capabilities on GitHub)
# VITE_DOMAIN_CAPABILITIES_REPO=okkey/domain-capabilities
# VITE_DOMAIN_CAPABILITIES_BRANCH=main
