# Copy to `.env` for local overrides (do not commit secrets).
#
# Vite dev server: http://localhost:5173 (see vite.config.ts)

VITE_APP_ENV=development
# Must be the API origin (port 4000), not the Vite dev server (5173). Avoid the literal string "undefined".
VITE_API_BASE_URL=http://localhost:4000
VITE_S3_BASE_URL=http://localhost:9000
# false = FREE-only UI (default). true = load okkey-enterprise web modules.
VITE_ENTERPRISE_MODULES=false
# self_hosted (default) | saas — multi-workspace create UI requires enterprise modules + saas.
# VITE_DEPLOYMENT_MODE=self_hosted
#
# SaaS privacy policy operator (used when VITE_ENTERPRISE_MODULES=true and VITE_DEPLOYMENT_MODE=saas).
# Placeholders only — set real values in deployment secrets / env, do not invent a company name.
# VITE_LEGAL_ENTITY_NAME_RU=ООО «Пример»
# VITE_LEGAL_ENTITY_NAME_EN=Example LLC
# VITE_LEGAL_ENTITY_ADDRESS_RU=123456, г. Пример, ул. Примерная, д. 1
# VITE_LEGAL_ENTITY_ADDRESS_EN=123456, Example City, Example St. 1
# VITE_LEGAL_PRIVACY_EMAIL=privacy@example.com
#
# Optional: override domain capabilities catalog URLs (defaults: GitHub raw + jsDelivr + statically.io race)
# VITE_DOMAIN_CAPABILITIES_REPO=okkeyapp/domain-capabilities
# VITE_DOMAIN_CAPABILITIES_BRANCH=main
