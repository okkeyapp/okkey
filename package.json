{
  "name": "okkey",
  "version": "0.0.1",
  "private": true,
  "description": "Okkey Core",
  "homepage": "https://github.com/okkeyapp/okkey#readme",
  "bugs": {
    "url": "https://github.com/okkeyapp/okkey/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okkeyapp/okkey.git"
  },
  "license": "AGPL-3.0-or-later",
  "author": "okkey",
  "type": "commonjs",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "engines": {
    "node": ">=25 <26",
    "yarn": "^1.22.0"
  },
  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "vite": "6.1.0"
  },
  "workspaces": [
    "packages/*",
    "apps/web"
  ],
  "dependencies": {
    "@okkey/crypto-wasm": "file:./packages/crypto/dist",
    "@okkey/email-templates": "0.0.1",
    "@okkey/i18n": "0.0.1",
    "nodemailer": "^7.0.5",
    "pg": "^8.16.3",
    "redis": "^5.9.0",
    "smtp-server": "^3.14.0"
  },
  "scripts": {
    "build:wasm": "PATH=\"$HOME/.cargo/bin:$PATH\" RUSTUP_TOOLCHAIN=stable node packages/crypto/scripts/build.mjs",
    "check:all": "yarn check:crypto && yarn build:wasm && yarn check:sdk && yarn check:i18n && yarn check:email-templates",
    "check:crypto": "cargo test --manifest-path rust/crypto-engine/Cargo.toml",
    "check:sdk": "yarn check:sdk:types && yarn check:sdk:api && yarn check:sdk:auth && yarn check:sdk:vault && yarn check:sdk:sync && yarn check:sdk:ui",
    "check:sdk:api": "npx --yes -p typescript tsc -p packages/api/tsconfig.json",
    "check:sdk:auth": "npx --yes -p typescript tsc -p packages/auth/tsconfig.json",
    "check:sdk:sync": "npx --yes -p typescript tsc -p packages/sync/tsconfig.json",
    "build:ts-sdk": "npx --yes -p typescript tsc -p packages/types/tsconfig.json && npx --yes -p typescript tsc -p packages/sync/tsconfig.json",
    "check:sdk:types": "npx --yes -p typescript tsc -p packages/types/tsconfig.json",
    "check:sdk:ui": "npx --yes -p typescript tsc -p packages/ui/tsconfig.json",
    "check:sdk:vault": "npx --yes -p typescript tsc -p packages/vault/tsconfig.json",
    "check:i18n": "yarn --cwd packages/i18n build",
    "check:email-templates": "npx --yes -p typescript tsc -p packages/email-templates/tsconfig.json",
    "build:i18n": "yarn --cwd packages/i18n build",
    "build:email-templates": "yarn --cwd packages/email-templates build",
    "build:email": "yarn build:i18n && yarn build:email-templates",
    "dev:email": "yarn --cwd packages/email-templates dev",
    "dev:api": "yarn build:email && node --experimental-strip-types services/api/src/index.ts",
    "dev:web": "yarn --cwd apps/web dev",
    "build:web": "yarn --cwd apps/web build",
    "test:web": "yarn --cwd apps/web test",
    "dev:worker": "echo 'TODO: add worker dev command' && exit 1",
    "infra:down": "./scripts/infra.sh down",
    "infra:logs": "./scripts/infra.sh logs",
    "infra:ps": "./scripts/infra.sh ps",
    "infra:up": "./scripts/infra.sh up",
    "test": "yarn test:api && yarn test:e2e && yarn test:web",
    "test:api": "yarn build:wasm && yarn build:ts-sdk && yarn build:email && node --experimental-strip-types --test --test-concurrency=1 services/api/test/*.test.ts",
    "test:e2e": "yarn build:email && node --experimental-strip-types --test services/api/test/*.e2e.test.ts"
  }
}
