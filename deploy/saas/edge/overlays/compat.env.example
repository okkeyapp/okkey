# SaaS optional classical-only compatibility listeners (Q-Day #3 q3-4).
# DISABLED BY DEFAULT. Merge into stage.env / prod.env only for an explicit,
# time-boxed exception on isolated hostnames — never the default app/api hosts.
#
# Shared nginx image + entrypoint enforce sunset/owner/isolation (see
# deploy/docker/proxy/nginx/docker-entrypoint.sh).
#
# Isolation: dedicated hostname + dedicated listen port (default 8443, not 443)
# + dedicated compat-*.pem certs. Same-port different ssl_ecdh_curve is unsafe
# under nginx TLS 1.3 (default SSL_CTX owns key_share).

OKKEY_COMPAT_ENABLED=0

# Example isolated hosts (must differ from OKKEY_WEB_HOST / OKKEY_API_HOST):
# OKKEY_COMPAT_WEB_HOST=compat-app.stage.okkey.app
# OKKEY_COMPAT_API_HOST=compat-api.stage.okkey.app

# Dedicated port (must not be 443):
OKKEY_COMPAT_HTTPS_PORT=8443

# Required when ENABLED=1:
# OKKEY_COMPAT_SUNSET=2026-12-31
# OKKEY_COMPAT_OWNER=sre-oncall@okkey.app

# Optional CIDR allowlist:
# OKKEY_COMPAT_ALLOW_CIDRS=10.0.0.0/8
# Mount dedicated compat-fullchain.pem / compat-privkey.pem (gen-self-signed.sh --with-compat).
