# SaaS stage edge — copy to stage.env and edit.
# TLS policy comes from the shared nginx image (TLS 1.3 + X25519MLKEM768 only).
# Do not add OKKEY_*_CURVE / ssl_ecdh_curve overrides here.

OKKEY_SAAS_ENV=stage

OKKEY_WEB_HOST=app.stage.okkey.app
OKKEY_API_HOST=api.stage.okkey.app

# Private upstreams (service mesh / internal LB). Adjust to the stage cluster DNS.
OKKEY_WEB_UPSTREAM=web.stage.svc.cluster.local:80
OKKEY_API_UPSTREAM=api.stage.svc.cluster.local:4000

OKKEY_PROXY_HTTP_PORT=80
OKKEY_PROXY_HTTPS_PORT=443

# Optional image/build pins (defaults match self-host proxy)
# OKKEY_PROXY_OPENSSL_VERSION=3.5.0
# OKKEY_PROXY_NGINX_VERSION=1.28.0
# OKKEY_SAAS_EDGE_IMAGE=okkey-saas-edge-nginx:openssl35
