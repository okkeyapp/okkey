# Okkey Core — self-host environment (copy to .env; install.sh generates secrets).
# Do not commit real secrets.

# Image tag (semver, pre-release like 0.0.0-pr19.3, or latest after a clean vX.Y.Z release)
OKKEY_IMAGE_TAG=0.0.0-pr19.3
# Optional image overrides (defaults: ghcr.io/okkeyapp/{api,web,worker})
# OKKEY_API_IMAGE=ghcr.io/okkeyapp/api
# OKKEY_WEB_IMAGE=ghcr.io/okkeyapp/web
# OKKEY_WORKER_IMAGE=ghcr.io/okkeyapp/worker

# Published ports on the host
WEB_PORT=8080
API_PORT=4000

# Public URLs (browser-reachable). Change these when using a real domain + TLS reverse proxy.
PUBLIC_APP_URL=http://localhost:8080
OKKEY_API_PUBLIC_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:8080
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Okkey
WEBAUTHN_ORIGINS=http://localhost:8080

# Postgres
POSTGRES_USER=okkey
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=okkey

# MinIO / S3
MINIO_ROOT_USER=okkey
MINIO_ROOT_PASSWORD=change-me-minio
S3_BUCKET=okkey
S3_REGION=us-east-1

# Server secrets (install.sh generates strong values)
# SESSION_SECRET is used for sessions / TOTP at rest; JWT_SECRET is accepted as an alias.
JWT_SECRET=change-me-jwt
SESSION_SECRET=change-me-session

# Email (logger = OTP in API/worker logs only; set smtp for real delivery)
# Production compose uses EMAIL_DELIVERY_MODE=queue: API enqueues to Redis, worker sends.
EMAIL_FROM=no-reply@okkey.local
EMAIL_PROVIDER=logger
EMAIL_DELIVERY_MODE=queue
EMAIL_DEFAULT_LOCALE=en
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURE=false
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=

# Capsule GeoIP (optional; needs an MMDB volume — off by default in this MVP)
GEOIP_ENABLED=false
