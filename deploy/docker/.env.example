# Okkey Core — self-host environment (copy to .env; install.sh generates secrets).
# Do not commit real secrets.

# Image tag for this release (spelling **beta**, never betta). Never floating `:latest`.
# The floating `:dev` image is published only by a manual workflow_dispatch of
# "Publish container images" (.github/workflows/publish-images.yml). The dispatch
# input `tag` defaults to `dev`. Push to `dev` does not publish `:dev`.
# Install pin: OKKEY_IMAGE_TAG=1.0.0-beta.2 and OKKEY_REF=v1.0.0-beta.2
# (set both on the right of `|`). Cosign signature verification stays on.
# GHCR publishes `:1.0.0-beta.2` when git tag `v1.0.0-beta.2` lands.
OKKEY_IMAGE_TAG=1.0.0-beta.2
# Optional image overrides (defaults: ghcr.io/okkeyapp/{api,web,worker})
# OKKEY_API_IMAGE=ghcr.io/okkeyapp/api
# OKKEY_WEB_IMAGE=ghcr.io/okkeyapp/web
# OKKEY_WORKER_IMAGE=ghcr.io/okkeyapp/worker

# Published ports on the host
WEB_PORT=8080
# API is bound to 127.0.0.1 only (see docker-compose.prod.yml). Local health checks and
# same-host browsers still use localhost; do not publish 0.0.0.0 when TRUSTED_PROXY_HOPS≥1.
API_PORT=4000

# Public URLs (browser-reachable). Change these when using a real domain + TLS reverse proxy.
# PQ TLS edge template: deploy/docker/proxy/ (nginx + OpenSSL ≥ 3.5 / X25519MLKEM768).
PUBLIC_APP_URL=http://localhost:8080
OKKEY_API_PUBLIC_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:8080
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Okkey
WEBAUTHN_ORIGINS=http://localhost:8080
# When using proxy/docker-compose.proxy.yml:
# OKKEY_WEB_HOST=app.example.com
# OKKEY_API_HOST=api.example.com
# PUBLIC_APP_URL=https://app.example.com
# OKKEY_API_PUBLIC_URL=https://api.example.com
# CORS_ORIGIN=https://app.example.com
# WEBAUTHN_ORIGINS=https://app.example.com
# WEBAUTHN_RP_ID=example.com
# TRUSTED_PROXY_HOPS=1
# (API stays on 127.0.0.1:${API_PORT}; nginx uses Docker DNS api:4000 — do not re-bind API to 0.0.0.0.)

# Postgres
POSTGRES_USER=okkey
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=okkey

# MinIO / S3
MINIO_ROOT_USER=okkey
MINIO_ROOT_PASSWORD=change-me-minio
S3_BUCKET=okkey
S3_REGION=us-east-1

# Server secrets (install.sh generates strong values)
# SESSION_SECRET is used for sessions / TOTP at rest; JWT_SECRET is accepted as an alias.
# EMAIL_DEAD_LETTER_SEAL_KEY seals verification-code bodies in okkey:email:dead (stable across restarts).
JWT_SECRET=change-me-jwt
SESSION_SECRET=change-me-session
EMAIL_DEAD_LETTER_SEAL_KEY=change-me-email-dead-letter-seal

# Crypto policy (api + worker). Vault items require profile 2 for read and write.
# New registration sends password_kdf_params_version=2.
# CRYPTO_ALLOWED_PROFILE_VERSIONS can only narrow the allowlist. Including 1 refuses to start.
# CRYPTO_ROLLOUT_MODE=compat is refused at startup when DEPLOY_ENV=prod. Production compose default is strict.
DEPLOY_ENV=dev
CRYPTO_ALLOWED_PROFILE_VERSIONS=2
CRYPTO_ROLLOUT_MODE=compat

# Email (logger = OTP in API/worker logs only; set smtp for real delivery)
# Production compose uses EMAIL_DELIVERY_MODE=queue: API enqueues to Redis, worker sends.
EMAIL_FROM=no-reply@okkey.local
# Required: sales inbox for license / plan-change requests (api + worker).
# No built-in default — set a real address before starting (install.sh prompts).
OKKEY_SALES_EMAIL=
EMAIL_PROVIDER=logger
EMAIL_DELIVERY_MODE=queue
EMAIL_DEFAULT_LOCALE=en
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURE=false
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
# Generic HTTP webhook (EMAIL_PROVIDER=http-api):
# EMAIL_API_ENDPOINT=https://mail.example.com/send
# EMAIL_API_KEY=
# EMAIL_API_TIMEOUT_MS=10000
# Logo embedding for http-api: cid (default) | data | none | url
# EMAIL_HTTP_API_INLINE=cid
# Required when EMAIL_HTTP_API_INLINE=url (public https only; no localhost):
# EMAIL_LOGO_URL=https://cdn.example.com/okkey-mark.png

# Client IP for rate limits. Default 0 ignores X-Forwarded-For (uses TCP peer).
# Behind deploy/docker/proxy nginx (or any single trusted reverse proxy), set 1.
# Requires API not reachable on 0.0.0.0 (compose binds 127.0.0.1:${API_PORT}).
TRUSTED_PROXY_HOPS=0

# Capsule GeoIP (optional; needs an MMDB volume — off by default in this MVP)
GEOIP_ENABLED=false

# Website icons. Unset or `off` (compose default): the API does not fetch icons and
# does not learn login-item domains. Clients show a letter monogram.
# `direct`: opt in to server-side fetches from each site.
# `client`: clients load https://<host>/favicon.ico themselves (the site and DNS see that).
# `google`: opt in; sends website domains to Google's favicon service.
# FAVICON_PROVIDER=off

# Self-host system updates.
# Core feed. Empty uses https://github.com/okkeyapp/okkey/releases/latest/download/feed.json
# Set a URL to override that default. OKKEY_UPDATE_FEED_URL still overrides when this is empty.
# OKKEY_UPDATE_ISOLATED=true skips every update check, including the default core feed.
# Apply runs in the update-agent service after an admin clicks Update. The web container has no Docker socket.
# Trust the offline package with an ed25519 SPKI public key (PEM, use \n for line breaks).
# Core packages are checked only with OKKEY_UPDATE_TRUSTED_PUBLIC_KEY.
# Enterprise packages are checked only with OKKEY_UPDATE_ENTERPRISE_TRUSTED_PUBLIC_KEY.
OKKEY_UPDATE_CORE_FEED_URL=
# Separate feed for enterprise packages. Leave empty to skip that check.
# Used only when enterprise modules are installed.
OKKEY_UPDATE_ENTERPRISE_FEED_URL=
OKKEY_UPDATE_ISOLATED=false
OKKEY_UPDATE_TRUSTED_PUBLIC_KEY=
OKKEY_UPDATE_ENTERPRISE_TRUSTED_PUBLIC_KEY=
OKKEY_UPDATE_AGENT_TOKEN=
OKKEY_COMPOSE_PROJECT=okkey
OKKEY_HOST_INSTALL_DIR=
OKKEY_ENTERPRISE_VERSION=
