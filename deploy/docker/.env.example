# Okkey Core — self-host environment (copy to .env; install.sh generates secrets).
# Do not commit real secrets.

# Image tag channel:
#   tracking / QA (files from `dev`) → floating `dev` (published on every push to `dev`)
#   production                       → pin a published SemVer from a main release
#                                      (never use floating `:latest` for prod installs)
# Override at install time: OKKEY_IMAGE_TAG=… on the right of `|` (same as OKKEY_REF).
# OKKEY_CHANNEL=prod is refused by install.sh until a SemVer tag exists in GHCR
# (historical pin name 1.0.0-beta.2 is not published yet; use OKKEY_IMAGE_TAG=dev).
OKKEY_IMAGE_TAG=dev
# Optional product version for GET /version (else uses OKKEY_IMAGE_TAG / package.json).
# OKKEY_VERSION=1.0.0
# OKKEY_ENTERPRISE_VERSION=1.0.0-beta.1
# Optional update feed for GET /updates/check (file path preferred; empty = no outbound check).
# OKKEY_UPDATE_FEED_PATH=
# OKKEY_UPDATE_FEED_URL=

# Optional image overrides (defaults: ghcr.io/okkeyapp/{api,web,worker})
# OKKEY_API_IMAGE=ghcr.io/okkeyapp/api
# OKKEY_WEB_IMAGE=ghcr.io/okkeyapp/web
# OKKEY_WORKER_IMAGE=ghcr.io/okkeyapp/worker

# Published ports on the host
WEB_PORT=8080
API_PORT=4000

# Public URLs (browser-reachable). Change these when using a real domain + TLS reverse proxy.
# PQ TLS edge template: deploy/docker/proxy/ (nginx + OpenSSL ≥ 3.5 / X25519MLKEM768).
PUBLIC_APP_URL=http://localhost:8080
OKKEY_API_PUBLIC_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:8080
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Okkey
WEBAUTHN_ORIGINS=http://localhost:8080
# When using proxy/docker-compose.proxy.yml:
# OKKEY_WEB_HOST=app.example.com
# OKKEY_API_HOST=api.example.com
# PUBLIC_APP_URL=https://app.example.com
# OKKEY_API_PUBLIC_URL=https://api.example.com
# CORS_ORIGIN=https://app.example.com
# WEBAUTHN_ORIGINS=https://app.example.com
# WEBAUTHN_RP_ID=example.com

# Postgres
POSTGRES_USER=okkey
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=okkey

# MinIO / S3
MINIO_ROOT_USER=okkey
MINIO_ROOT_PASSWORD=change-me-minio
S3_BUCKET=okkey
S3_REGION=us-east-1

# Server secrets (install.sh generates strong values)
# SESSION_SECRET is used for sessions / TOTP at rest; JWT_SECRET is accepted as an alias.
# EMAIL_DEAD_LETTER_SEAL_KEY seals verification-code bodies in okkey:email:dead (stable across restarts).
JWT_SECRET=change-me-jwt
SESSION_SECRET=change-me-session
EMAIL_DEAD_LETTER_SEAL_KEY=change-me-email-dead-letter-seal

# Crypto policy (api + worker). Self-host web still sends password_kdf_params_version=1
# on register; DEPLOY_ENV=prod only allows profile [2] and returns CRYPTO_PROFILE_NOT_ALLOWED.
# Keep deployEnv=dev (or stage is also v2-only) so 1,2 are allowed. Do not set
# CRYPTO_ALLOWED_PROFILE_VERSIONS=1 with DEPLOY_ENV=prod — API refuses to start.
DEPLOY_ENV=dev
CRYPTO_ALLOWED_PROFILE_VERSIONS=1,2
CRYPTO_ROLLOUT_MODE=compat

# Email (logger = OTP in API/worker logs only; set smtp for real delivery)
# Production compose uses EMAIL_DELIVERY_MODE=queue: API enqueues to Redis, worker sends.
EMAIL_FROM=no-reply@okkey.local
EMAIL_PROVIDER=logger
EMAIL_DELIVERY_MODE=queue
EMAIL_DEFAULT_LOCALE=en
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURE=false
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=

# Capsule GeoIP (optional; needs an MMDB volume — off by default in this MVP)
GEOIP_ENABLED=false

# Favicon preview: direct (default) | off | google (opt-in; sends website domains to Google)
# Prefer direct or off for self-hosted deployments.
# FAVICON_PROVIDER=direct
