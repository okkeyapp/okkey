# Okkey edge — OPTIONAL classical-only compatibility listeners.
# Enabled only when OKKEY_COMPAT_ENABLED=1 (see docker-entrypoint.sh).
#
# Policy (runbook 6.19):
# - explicit opt-in (disabled by default)
# - isolated hostnames (never the default app/api hosts)
# - isolated listen port (default ${OKKEY_COMPAT_HTTPS_PORT} / 8443)
# - catch-all must share the classical TLS profile, otherwise OpenSSL defaults
#   apply to compat SNI (default SSL_CTX for the listen socket)
# - catch-all: ssl_reject_handshake on (foreign/missing SNI) + location / → 421
#   (no html root; HTTP/1.1 Host rematch hits catch-all)
# - ssl_session_cache/tickets off — TLS 1.2 resume must not bypass reject
# - classical curves only (X25519); ECDHE+AEAD ciphers; prefer_server_ciphers on
#
# Substituted at container start.

# --- Compat port catch-all (default SSL_CTX for this listen socket) ---
server {
  listen ${OKKEY_COMPAT_HTTPS_PORT} ssl default_server;
  listen [::]:${OKKEY_COMPAT_HTTPS_PORT} ssl default_server;
  server_name _;

  # Same classical TLS profile as named compat servers (policy).
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ecdh_curve X25519;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
  ssl_prefer_server_ciphers on;
  ssl_session_cache off;
  ssl_session_tickets off;

  # Reject unknown / missing SNI at handshake.
  ssl_reject_handshake on;

  # HTTP/1.1 Host rematch lands here after a valid compat SNI (policy).
  location / {
    return 421;
  }
}

# --- Compat web (classical) ---
server {
  listen ${OKKEY_COMPAT_HTTPS_PORT} ssl;
  listen [::]:${OKKEY_COMPAT_HTTPS_PORT} ssl;
  http2 on;
  server_name ${OKKEY_COMPAT_WEB_HOST};

  ssl_certificate     /etc/nginx/certs/compat-fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/compat-privkey.pem;

  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ecdh_curve X25519;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
  ssl_prefer_server_ciphers on;
  ssl_session_cache off;
  ssl_session_tickets off;

  include /etc/nginx/conf.d/compat-allow.inc;

  # Belt-and-suspenders if Host rematch somehow stays on this server.
  if ($host != "${OKKEY_COMPAT_WEB_HOST}") {
    return 421;
  }

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Okkey-Tls-Profile "compat-classical" always;
  add_header X-Okkey-Compat-Sunset "${OKKEY_COMPAT_SUNSET}" always;

  location / {
    proxy_pass http://${OKKEY_WEB_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }
}

# --- Compat API (classical) ---
server {
  listen ${OKKEY_COMPAT_HTTPS_PORT} ssl;
  listen [::]:${OKKEY_COMPAT_HTTPS_PORT} ssl;
  http2 on;
  server_name ${OKKEY_COMPAT_API_HOST};

  ssl_certificate     /etc/nginx/certs/compat-fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/compat-privkey.pem;

  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ecdh_curve X25519;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
  ssl_prefer_server_ciphers on;
  ssl_session_cache off;
  ssl_session_tickets off;

  include /etc/nginx/conf.d/compat-allow.inc;

  if ($host != "${OKKEY_COMPAT_API_HOST}") {
    return 421;
  }

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Okkey-Tls-Profile "compat-classical" always;
  add_header X-Okkey-Compat-Sunset "${OKKEY_COMPAT_SUNSET}" always;

  # Attachment and general API uploads (workspace file size may be higher).
  client_max_body_size 64m;

  # Offline update apply bodies are capped near ~1.3 MiB (archive + base64 + envelope).
  location /system/updates/ {
    client_max_body_size 2m;
    proxy_pass http://${OKKEY_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;
  }

  location / {
    proxy_pass http://${OKKEY_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;
  }
}
