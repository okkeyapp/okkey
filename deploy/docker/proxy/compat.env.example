# Optional classical-only compatibility listeners (Q-Day #3 q3-4).
# DISABLED BY DEFAULT — copy knobs into the install .env only for an explicit,
# time-boxed exception. Never point these hosts at the strict default hostnames.
#
# Policy:
#   - explicit: OKKEY_COMPAT_ENABLED=1
#   - isolated hostnames: not OKKEY_WEB_HOST / OKKEY_API_HOST
#   - isolated listen port: OKKEY_COMPAT_HTTPS_PORT (default 8443, must NOT be 443)
#     nginx/OpenSSL TLS 1.3 picks key_share from the default SSL_CTX per listen
#     socket — different curves/protocols cannot share :443 with the hybrid default.
#     Technical choice: dedicated port (+ dedicated cert). Separate IP left open for Саша.
#   - N1: catch-all on compat port uses ssl_reject_handshake; foreign SNI / Host → reject / 421
#   - time-boxed: OKKEY_COMPAT_SUNSET (UTC YYYY-MM-DD) + OKKEY_COMPAT_OWNER
#   - classical curves only on compat (X25519); TLS 1.2 = ECDHE+AEAD only
#
# Certs: run scripts/gen-self-signed.sh --with-compat (writes dedicated
# compat-fullchain.pem / compat-privkey.pem with compat SANs). Do NOT reuse the
# strict fullchain.pem for compat.
#
# N8 — publish port ONLY when enabling compat (base overlay does not map 8443):
#   docker compose -f docker-compose.prod.yml \
#     -f proxy/docker-compose.proxy.yml \
#     -f proxy/docker-compose.compat.yml \
#     --env-file .env up -d --build proxy

OKKEY_COMPAT_ENABLED=0

# Example isolated hosts (must differ from OKKEY_WEB_HOST / OKKEY_API_HOST):
# OKKEY_COMPAT_WEB_HOST=compat-app.example.com
# OKKEY_COMPAT_API_HOST=compat-api.example.com

# Dedicated listen port inside the proxy container (compose.compat maps host:container).
# Must not be 443.
OKKEY_COMPAT_HTTPS_PORT=8443

# Required when ENABLED=1:
# OKKEY_COMPAT_SUNSET=2026-12-31
# OKKEY_COMPAT_OWNER=sre-oncall@example.com

# Optional comma-separated CIDR allowlist (empty = hostname+port isolation only):
# OKKEY_COMPAT_ALLOW_CIDRS=10.0.0.0/8,192.168.0.0/16
