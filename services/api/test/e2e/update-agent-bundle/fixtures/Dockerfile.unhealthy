# Unhealthy enterprise-like stub for partial rollback e2e.
FROM alpine:3.20
RUN adduser -D -u 65532 nonroot && mkdir -p /okkey && chown nonroot:nonroot /okkey
WORKDIR /okkey
USER nonroot
ENV OKKEY_GIT_SHA=enterprise-unhealthy
HEALTHCHECK --interval=1s --timeout=1s --retries=1 CMD false
ENTRYPOINT ["sh", "-c"]
CMD ["sleep infinity"]
