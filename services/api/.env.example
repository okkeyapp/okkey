# API service (local development)
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://okkey:okkey@localhost:5432/okkey

# Redis
REDIS_URL=redis://localhost:6379

# Object storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=okkey
S3_ACCESS_KEY=okkey
S3_SECRET_KEY=okkey-minio
S3_FORCE_PATH_STYLE=true

# Security (dev only)
JWT_SECRET=dev-jwt-secret
SESSION_SECRET=dev-session-secret

# CORS
CORS_ORIGIN=http://localhost:3000

# Auth (email code)
AUTH_CODE_TTL_SECONDS=300
AUTH_RESEND_COOLDOWN_SECONDS=60
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=600
AUTH_RATE_LIMIT_START_PER_EMAIL=5
AUTH_RATE_LIMIT_START_PER_IP=10
AUTH_RATE_LIMIT_CONFIRM_PER_IP=30
AUTH_RATE_LIMIT_RESEND_PER_IP=10

# Registration (after email confirm, new users only)
REGISTRATION_AUTH_STATE_TTL_SECONDS=3600
REGISTRATION_RESULT_TTL_SECONDS=604800

# Email
EMAIL_DEFAULT_LOCALE=en
EMAIL_FROM=no-reply@okkey.local
EMAIL_PROVIDER=logger

# SMTP provider (EMAIL_PROVIDER=smtp)
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# HTTP API provider (EMAIL_PROVIDER=http-api)
EMAIL_API_ENDPOINT=
EMAIL_API_KEY=
EMAIL_API_TIMEOUT_MS=10000
