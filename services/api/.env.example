# API service (local development)
NODE_ENV=development
DEPLOY_ENV=dev
PORT=4000
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://okkey:okkey@localhost:5432/okkey

# Redis
REDIS_URL=redis://localhost:6379

# Object storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=okkey
S3_ACCESS_KEY=okkey
S3_SECRET_KEY=okkey-minio
S3_FORCE_PATH_STYLE=true

# Security (dev only)
JWT_SECRET=dev-jwt-secret
# Production compose sets RUN_BACKGROUND_JOBS=false on API and runs services/api/src/worker.ts separately.
# Local yarn dev:api keeps background jobs in-process unless NODE_ENV=production.
# RUN_BACKGROUND_JOBS=true
# Local web origin for CORS + WebAuthn (comma-separated)
# CORS_ORIGIN=http://localhost:5173
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Okkey
WEBAUTHN_ORIGINS=http://localhost:5173
WEBAUTHN_CHALLENGE_TTL_SECONDS=300

SESSION_SECRET=dev-session-secret
# Bearer session lifetime (seconds); TOTP secret encryption + backup-code pepper derive from SESSION_SECRET
SESSION_TTL_SECONDS=604800
AUTH_PENDING_TWO_FACTOR_TTL_SECONDS=600
TOTP_ENROLLMENT_TTL_SECONDS=600
TWO_FACTOR_VERIFY_MAX_ATTEMPTS=5
TWO_FACTOR_VERIFY_CLOCK_STEPS=1
AUTH_RATE_LIMIT_TWO_FACTOR_VERIFY_PER_IP=40
TWO_FACTOR_BACKUP_CODES_COUNT=10
# Production: set ALLOW_HEADER_USER_ID_AUTH=true only for emergency tooling (default off in production)
# Local dev: custom roles on FREE workspaces are allowed when NODE_ENV=development (override with ALLOW_FREE_CUSTOM_ROLES=false)

# Enterprise backend plugins (okkey-enterprise sibling repo)
# Bootstrap only in Core — SaaS deployment mode is NOT documented here.
ENTERPRISE_MODULES=false
# ENTERPRISE_MODULES_PATH=/abs/path/to/okkey-enterprise
# ALLOW_FREE_CUSTOM_ROLES=true
# With ENTERPRISE_MODULES=true, new registration workspaces get plan_tier=ENTERPRISE (dev convenience).
# SaaS multi-workspace (POST /workspaces): see okkey-enterprise/backend/.env.example
# Upgrade existing local FREE workspaces:
#   UPDATE workspaces SET plan_tier = 'ENTERPRISE' WHERE plan_tier IN ('FREE','TEAM','PREMIUM','FAMILY');

# CORS (comma-separated allowlist; must include the web dev origin, e.g. Vite on 5173)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Auth (email code)
AUTH_CODE_TTL_SECONDS=300
AUTH_RESEND_COOLDOWN_SECONDS=60
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=600
AUTH_RATE_LIMIT_START_PER_EMAIL=5
AUTH_RATE_LIMIT_START_PER_IP=10
AUTH_RATE_LIMIT_CONFIRM_PER_IP=30
AUTH_RATE_LIMIT_RESEND_PER_IP=10
CAPSULE_OPEN_RATE_LIMIT_PER_IP=60
CAPSULE_RATE_LIMIT_WINDOW_SECONDS=60

# Crypto baseline policy by environment:
# - dev default allows legacy and current profiles (1,2)
# - stage/prod default allow only v2
# Override with a comma-separated list when needed, e.g. CRYPTO_ALLOWED_PROFILE_VERSIONS=2
CRYPTO_ALLOWED_PROFILE_VERSIONS=1,2
# Rollout policy mode: strict blocks non-PQ capable writes; compat allows controlled rollout.
CRYPTO_ROLLOUT_MODE=compat
# Emergency control-plane gates for stop/resume without code hotfixes.
CRYPTO_ROLLOUT_ENABLED=true
CRYPTO_ROLLOUT_STATE=resume
# Comma-separated write paths to pause when state=stop. Empty means stop all.
# Supported: registration.complete,sync.append,vault.share,vault.revoke,vault.rotate,vault.member_role_update,capsule.create or *
CRYPTO_ROLLOUT_STOP_WRITE_PATHS=

# Registration (after email confirm, new users only)
REGISTRATION_AUTH_STATE_TTL_SECONDS=3600
REGISTRATION_RESULT_TTL_SECONDS=604800

# Email
EMAIL_DEFAULT_LOCALE=en
EMAIL_FROM=no-reply@okkey.local
# logger | smtp | ses | http-api
# Default logger does not deliver mail (OTP may appear in API logs in non-prod).
EMAIL_PROVIDER=logger
# Logger: OTP appears in log field `plainText` when DEPLOY_ENV=dev, NODE_ENV is not production, or EMAIL_LOG_PLAINTEXT=true.
EMAIL_LOG_PLAINTEXT=

# Required for invite links and other CTA URLs in mail (e.g. http://localhost:5173).
PUBLIC_APP_URL=http://localhost:5173

# Sales inbox for workspace plan-change requests (manual fulfillment; no auto-charge yet).
# Local/dev default when unset: aleksandr-zoryn@ya.ru
# Production default when unset: hello@okkey.io
# OKKEY_SALES_EMAIL=aleksandr-zoryn@ya.ru

# --- SMTP (EMAIL_PROVIDER=smtp) ---
# Personal mailbox (self-hosted): use an app password, not the account login password.
#   Yandex:  EMAIL_SMTP_HOST=smtp.yandex.ru  EMAIL_SMTP_PORT=465  EMAIL_SMTP_SECURE=true
#   Gmail:   EMAIL_SMTP_HOST=smtp.gmail.com  EMAIL_SMTP_PORT=587  EMAIL_SMTP_SECURE=false
# Enterprise SMTP (same protocol): Unisender Go, Postmark, Resend, OVH, mailbox.org, …
# Personal mailboxes have sending limits and can be blocked; prefer transactional SMTP/SES for teams.
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# --- SES-compatible API (EMAIL_PROVIDER=ses) ---
# AWS SES: leave EMAIL_SES_ENDPOINT empty (uses https://email.{region}.amazonaws.com).
# Yandex Cloud Postbox: set EMAIL_SES_ENDPOINT to the Postbox origin and EMAIL_SES_REGION=ru-central1.
EMAIL_SES_REGION=
EMAIL_SES_ACCESS_KEY_ID=
EMAIL_SES_SECRET_ACCESS_KEY=
EMAIL_SES_ENDPOINT=
EMAIL_SES_TIMEOUT_MS=10000

# Capsule GeoIP (DB-IP City Lite, local MMDB — no IP sent to third parties)
# Defaults: enabled=true, DB at <repo>/.data/geoip/city.mmdb
# GEOIP_ENABLED=true
# GEOIP_PROVIDER=db-ip
# GEOIP_DB_PATH=
# GEOIP_AUTO_UPDATE=false
# Behind a reverse proxy, set how many hops to trust for X-Forwarded-For:
# TRUSTED_PROXY_HOPS=1

# --- Generic HTTP webhook (EMAIL_PROVIDER=http-api) ---
EMAIL_API_ENDPOINT=
EMAIL_API_KEY=
EMAIL_API_TIMEOUT_MS=10000
