# Worker service (local development)
# Optional overrides — API also loads services/api/.env via loadConfig().
NODE_ENV=development
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://okkey:okkey@localhost:5432/okkey

# Redis
REDIS_URL=redis://localhost:6379

# Object storage (MinIO) — required for attachment hard-purge
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=okkey
S3_ACCESS_KEY=okkey
S3_SECRET_KEY=okkey-minio
S3_FORCE_PATH_STYLE=true

# Security (dev only) — SESSION_SECRET preferred; JWT_SECRET accepted as alias
SESSION_SECRET=dev-session-secret
JWT_SECRET=dev-jwt-secret

# Worker always runs background jobs; this flag is for the API process only.
# RUN_BACKGROUND_JOBS=false
