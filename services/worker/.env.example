# Worker service (local development)
NODE_ENV=development
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://okkey:okkey@localhost:5432/okkey

# Redis
REDIS_URL=redis://localhost:6379

# Object storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=okkey
S3_ACCESS_KEY=okkey
S3_SECRET_KEY=okkey-minio
S3_FORCE_PATH_STYLE=true

# Security (dev only)
JWT_SECRET=dev-jwt-secret
