# ============================================
# Okkey Project .gitignore
# ============================================

# ============================================
# Dependencies
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
package-lock.json
# yarn.lock is committed for reproducible installs and GitHub Actions (setup-node cache: yarn).
pnpm-lock.yaml

# ============================================
# Rust
# ============================================
rust/target/
rust/**/target/
rust/**/*.rs.bk
rust/Cargo.lock
**/*.pdb
**/*.dll
**/*.so
**/*.dylib
**/*.rlib
**/*.rmeta

# ============================================
# Rust - WASM Build Output
# ============================================
rust/pkg/
rust/**/*.wasm
rust/**/*.d.ts

# ============================================
# Environment & Secrets
# ============================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env
!*.env.example
!*.env.template

# ============================================
# IDE & Editors
# ============================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace
.jestrc
*.log

# ============================================
# Vite (apps/web)
# ============================================
apps/web/dist/
apps/web/.vite/

# ============================================
# React Native (apps/mobile)
# ============================================
apps/mobile/.expo/
apps/mobile/web-build/
apps/mobile/.expo-shared/
apps/mobile/ios/build/
apps/mobile/android/app/build/
apps/mobile/android/.gradle/
apps/mobile/android/captures/
apps/mobile/ios/Pods/
apps/mobile/node_modules/
*.hprof
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
*.ios
*.android

# ============================================
# Tauri (apps/desktop)
# ============================================
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/Cargo.lock
apps/desktop/dist/
apps/desktop/build/
apps/desktop/out/
apps/desktop/**/*.sig
apps/desktop/**/*.dmg
apps/desktop/**/*.app
apps/desktop/**/*.exe
apps/desktop/**/*.msi

# ============================================
# Browser Extension (apps/extension)
# ============================================
apps/extension/dist/
apps/extension/build/
apps/extension/*.pem
apps/extension/*.crx

# ============================================
# TypeScript
# ============================================
*.tsbuildinfo
next-env.d.ts

# ============================================
# Testing
# ============================================
coverage/
.nyc_output/
*.lcov
.jest/
test-results/
playwright-report/
playwright/.cache/

# ============================================
# Build Outputs
# ============================================
build/
dist/
out/
.next/
.nuxt/
.output/

# ============================================
# Docker
# ============================================
.docker/
docker-compose.override.yml
*.dockerfile.local

# ============================================
# Database
# ============================================
*.db
*.sqlite
*.sqlite3
*.data
*.log
postgres-data/
pgdata/

# ============================================
# Redis
# ============================================
dump.rdb
redis-data/

# ============================================
# Object Storage / MinIO
# ============================================
minio-data/
storage-data/
attachments-local/

# ============================================
# Terraform (infrastructure/terraform)
# ============================================
infrastructure/terraform/.terraform/
infrastructure/terraform/*.tfstate
infrastructure/terraform/*.tfstate.backup
infrastructure/terraform/*.tfstate.lock
infrastructure/terraform/.terraform.lock.hcl
infrastructure/terraform/overrides/
infrastructure/terraform/crashes/
*.tfplan
*.tfplan.json

# ============================================
# Kubernetes (infrastructure/kubernetes)
# ============================================
infrastructure/kubernetes/*.kubeconfig
infrastructure/kubernetes/secrets/
infrastructure/kubernetes/**/secrets.yaml
infrastructure/kubernetes/**/secrets.yml
infrastructure/kubernetes/local-overrides/

# ============================================
# Logs
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================
# Cache
# ============================================
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.swc
.turbo/
.vercel/

# ============================================
# Temporary Files
# ============================================
tmp/
temp/
.tmp/
.temp/
*.tmp
*.temp
*.bak
*.backup

# ============================================
# OS Files
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ============================================
# Security & Certificates
# ============================================
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
*.jks
*.keystore
*.secret
*.credentials

# ============================================
# Documentation - Local
# ============================================
docs/architecture/*.drawio
docs/architecture/*.png
docs/architecture/*.jpg
!docs/architecture/README.md

# ============================================
# Development Tools
# ============================================
.grype/
.syft/
.cosign/
*.swag
.go/

# ============================================
# Misc
# ============================================
*.tgz
*.tar.gz
*.zip
*.rar
*.7z
*.iso
*.img
*.bin
*.exe
*.msi
*.dmg
*.pkg
